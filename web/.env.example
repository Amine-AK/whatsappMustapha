# Copy this file to .env.local (local) or add each line in Vercel > Settings > Environment Variables.

# ---- Login --------------------------------------------------------------
# The password to open the app.
APP_PASSWORD=change-me
# Random text, at least 32 characters, used to sign the login cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ---- Google Sheets ------------------------------------------------------
# The long code in the sheet URL: docs.google.com/spreadsheets/d/<THIS>/edit
GOOGLE_SHEET_ID=
# The customer tab (default "Feuille 1"; the first tab is used if not found).
GOOGLE_SHEET_NAME=Feuille 1
# From the service account JSON key: "client_email" and "private_key".
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the whole key on one line, keeping the \n, inside double quotes.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ---- WATI (WhatsApp reminders) -----------------------------------------
# https://live-mt-server.wati.io/<your tenant ID> (the number in the WATI dashboard address).
WATI_API_ENDPOINT=https://live-mt-server.wati.io/10281911
# WATI API key (wati_…) with the "api", "wati_integration:write" or
# "messagetemplate:write" permission, or the legacy token from API Docs.
WATI_ACCESS_TOKEN=
# Name of the approved template (see README).
WATI_TEMPLATE_NAME=debt_reminder_ar
# The shop's WhatsApp number connected in WATI, international form without +.
WATI_CHANNEL_NUMBER=212658869574
# Shown in WATI's broadcast history.
WATI_BROADCAST_NAME=debt_reminder
